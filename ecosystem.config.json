{
  "apps": [
    {
      "name": "study-ai-docs",
      "script": "server/index.js",
      "cwd": "/opt/study-ai-docs",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "PORT": 3001,
        "NODE_OPTIONS": "--max-old-space-size=2048"
      },
      "error_file": "/var/log/study-ai-docs-err.log",
      "out_file": "/var/log/study-ai-docs-out.log",
      "merge_logs": true,
      "log_date_format": "YYYY-MM-DD HH:mm:ss",
      "max_restarts": 10,
      "min_uptime": "10s",
      "restart_delay": 5000,
      "watch": false,
      "autorestart": true
    }
  ]
}
